{
  "expo": {
    "name": "Ucube Atölyesi",
    "slug": "myMobileApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon-v1.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050A14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omurcan533.ucubeatolyesi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050A14",
        "foregroundImage": "./assets/brand/android-foreground-v1.png",
        "monochromeImage": "./assets/brand/android-monochrome-v1.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.omurcan533.ucubeatolyesi"
    },
    "web": {
      "favicon": "./assets/brand/favicon-v1.png",
      "backgroundColor": "#050A14",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/mascot-mark-v1.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#050A14"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/myMobileApp"
    },
    "scheme": "ucubeatolyesi"
  }
}
